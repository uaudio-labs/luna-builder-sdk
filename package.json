{
  "name": "@uaudio/luna-builder-sdk",
  "version": "3.1.2",
  "description": "SDK for building LUNA Add Ons that run inside LUNA or on the WebAssembly LUNA engine",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js",
      "require": "./dist/wire/index.cjs"
    },
    "./global": {
      "types": "./types/global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "FEATURES_LIST.md",
    "LICENSE",
    "NOTICE",
    "dist",
    "types",
    "templates",
    "examples",
    "docs",
    "skills",
    "plugins",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup && node scripts/sync-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "UA_LIVE=1 vitest run tests/live",
    "check": "npm run typecheck && npm test && npm run build && npm run docs:api && npm run check:plugin",
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "docs:api": "typedoc",
    "test:engine": "node tests/engine/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.3",
    "jsdom": "29.1.1",
    "tsup": "8.5.1",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "bin": {
    "ua-builder": "./dist/cli.js"
  }
}
